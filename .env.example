# 복사해서 .env로 쓰거나, 배포 서비스의 환경변수 설정에 넣는다. .env는 저장소에 올리지 않는다.

# 비우면 backend/data/app.db(SQLite)를 쓴다. 배포 때는 Neon 등 Postgres 주소.
DATABASE_URL=

# 로그인 토큰 서명 키. 아무도 모르는 긴 임의 문자열(예: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# 심사위원에게 줄 테스트 계정
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me

# 프론트 배포 주소(쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# 학습 명령이 만든 모델 파일. 없으면 1단계(변화 감지)만 동작
MODEL_PATH=models/presence_model.joblib

# 합성 신호 시나리오 재생 허용(개발용). 배포에서는 0
ALLOW_SYNTHETIC_DEMO=0
